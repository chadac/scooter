{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/icons": ["./src/icons/lucide.tsx"],
      "@/*": ["./*"]
    }
  },
  "include": ["src", "components", "lib", "../../contrib/*/ui/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "../../contrib/*/ui/*.test.tsx"]
}
