+    /// THE REGRESSION: a reasoning model (xAI Grok reasons by default) returns a
+    /// reasoningContent block on nearly every response. Before this arm existed it
+    /// hit the catch-all and failed the whole turn with
+    /// "Unsupported content block type from Bedrock".
+    #[test]
+    fn test_from_bedrock_content_block_reasoning_text() -> Result<()> {
+        let block = bedrock::ContentBlock::ReasoningContent(
+            bedrock::ReasoningContentBlock::ReasoningText(
+                bedrock::ReasoningTextBlock::builder()
+                    .text("step by step")
+                    .signature("sig-abc")
+                    .build()?,
+            ),
+        );
+
+        match from_bedrock_content_block(&block)? {
+            MessageContent::Thinking(t) => {
+                assert_eq!(t.thinking, "step by step");
+                assert_eq!(t.signature, "sig-abc");
+            }
+            other => panic!("expected Thinking, got {other:?}"),
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_from_bedrock_content_block_redacted_reasoning() -> Result<()> {
+        let block = bedrock::ContentBlock::ReasoningContent(
+            bedrock::ReasoningContentBlock::RedactedContent(aws_smithy_types::Blob::new(
+                b"secret".to_vec(),
+            )),
+        );
+
+        match from_bedrock_content_block(&block)? {
+            MessageContent::RedactedThinking(r) => {
+                let decoded = base64::engine::general_purpose::STANDARD.decode(&r.data)?;
+                assert_eq!(decoded, b"secret");
+            }
+            other => panic!("expected RedactedThinking, got {other:?}"),
+        }
+        Ok(())
+    }
+
+    /// Bedrock requires reasoning be replayed with text + signature UNMODIFIED in a
+    /// multi-turn conversation, so a signed Thinking block must round-trip rather
+    /// than collapse to an empty text block.
     #[test]
+    fn test_reasoning_round_trips_back_to_bedrock() -> Result<()> {
+        let original = bedrock::ContentBlock::ReasoningContent(
+            bedrock::ReasoningContentBlock::ReasoningText(
+                bedrock::ReasoningTextBlock::builder()
+                    .text("because X")
+                    .signature("sig-1")
+                    .build()?,
+            ),
+        );
+
+        let round_tripped = to_bedrock_message_content(&from_bedrock_content_block(&original)?)?;
+
+        match round_tripped {
+            bedrock::ContentBlock::ReasoningContent(
+                bedrock::ReasoningContentBlock::ReasoningText(t),
+            ) => {
+                assert_eq!(t.text, "because X");
+                assert_eq!(t.signature.as_deref(), Some("sig-1"));
+            }
+            other => panic!("expected ReasoningContent, got {other:?}"),
+        }
+        Ok(())
+    }
+
+    /// Thinking with NO signature did not come from Bedrock (e.g. an Anthropic-format
+    /// session replayed here) — Bedrock would reject an unsigned reasoning block, so
+    /// it keeps the old skip-as-empty-text behaviour.
+    #[test]
+    fn test_unsigned_thinking_is_skipped_outbound() -> Result<()> {
+        let content = MessageContent::thinking("no signature", "");
+        match to_bedrock_message_content(&content)? {
+            bedrock::ContentBlock::Text(t) => assert_eq!(t, ""),
+            other => panic!("expected empty Text, got {other:?}"),
+        }
+        Ok(())
+    }
