{
  "servers": [
    { "name": "fetch", "kind": "pypi", "spec": "mcp-server-fetch", "description": "Fetch a URL and read it as markdown" },
    { "name": "git", "kind": "pypi", "spec": "mcp-server-git", "description": "Read, search and manipulate git repositories" },
    { "name": "time", "kind": "pypi", "spec": "mcp-server-time", "description": "Time and timezone conversion" },
    { "name": "filesystem", "kind": "npm", "spec": "@modelcontextprotocol/server-filesystem", "args": ["/workspace"], "description": "File access scoped to /workspace" },
    { "name": "memory", "kind": "npm", "spec": "@modelcontextprotocol/server-memory", "description": "Knowledge-graph memory between sessions" },
    { "name": "sequential-thinking", "kind": "npm", "spec": "@modelcontextprotocol/server-sequential-thinking", "description": "Structured step-by-step reasoning" },
    { "name": "everything", "kind": "npm", "spec": "@modelcontextprotocol/server-everything", "description": "MCP reference server for testing clients" },
    { "name": "playwright", "kind": "nixpkgs", "spec": "playwright-mcp", "description": "Browser automation, browsers included" },
    { "name": "chrome-devtools", "kind": "npm", "spec": "chrome-devtools-mcp", "description": "Drive and debug a live Chrome" },
    { "name": "context7", "kind": "npm", "spec": "@upstash/context7-mcp", "description": "Up-to-date library documentation lookup" },
    { "name": "kubernetes", "kind": "npm", "spec": "mcp-server-kubernetes", "description": "kubectl against the sandbox kubeconfig" },
    { "name": "youtube-transcript", "kind": "npm", "spec": "@kimtaeyoon83/mcp-server-youtube-transcript", "description": "Fetch YouTube video transcripts" },
    { "name": "markitdown", "kind": "pypi", "spec": "markitdown-mcp", "description": "Convert pdf, docx, pptx and more to markdown" },
    { "name": "pandoc", "kind": "pypi", "spec": "mcp-pandoc", "description": "Document format conversion via pandoc" },
    { "name": "wikipedia", "kind": "pypi", "spec": "wikipedia-mcp", "description": "Search and read Wikipedia" },
    { "name": "arxiv", "kind": "pypi", "spec": "arxiv-mcp-server", "description": "Search and read arXiv papers" },
    { "name": "duckduckgo", "kind": "pypi", "spec": "duckduckgo-mcp-server", "description": "Web search without an API key" },
    { "name": "sqlite", "kind": "pypi", "spec": "mcp-server-sqlite", "args": ["--db-path", "/workspace/data.db"], "description": "Query SQLite databases" },
    { "name": "excel", "kind": "pypi", "spec": "excel-mcp-server", "args": ["stdio"], "description": "Read and write Excel workbooks" },
    { "name": "basic-memory", "kind": "pypi", "spec": "basic-memory", "args": ["mcp"], "description": "Persistent markdown notes knowledge base" },
    { "name": "nixos", "kind": "pypi", "spec": "mcp-nixos", "description": "nixpkgs and NixOS package and option search" },
    { "name": "terraform", "kind": "nixpkgs", "spec": "terraform-mcp-server", "description": "Terraform registry providers and modules" },
    { "name": "github", "kind": "nixpkgs", "spec": "github-mcp-server", "args": ["stdio"], "needs_api_key": true, "description": "GitHub repos, issues and pull requests" },
    { "name": "notion", "kind": "npm", "spec": "@notionhq/notion-mcp-server", "needs_api_key": true, "description": "Notion pages and databases" },
    { "name": "slack", "kind": "npm", "spec": "@modelcontextprotocol/server-slack", "needs_api_key": true, "description": "Slack channels and messages" },
    { "name": "brave-search", "kind": "npm", "spec": "@brave/brave-search-mcp-server", "needs_api_key": true, "description": "Brave web search" },
    { "name": "firecrawl", "kind": "npm", "spec": "firecrawl-mcp", "needs_api_key": true, "description": "Web scraping and crawling" },
    { "name": "sentry", "kind": "npm", "spec": "@sentry/mcp-server", "needs_api_key": true, "description": "Sentry issues and traces" },
    { "name": "postgres", "kind": "npm", "spec": "@modelcontextprotocol/server-postgres", "needs_api_key": true, "description": "Query Postgres over a connection URL" },
    { "name": "grafana", "kind": "nixpkgs", "spec": "mcp-grafana", "needs_api_key": true, "description": "Grafana dashboards, Loki and metrics" }
  ]
