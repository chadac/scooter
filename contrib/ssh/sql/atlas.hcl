// @generated by `just db-generate` from `contribs.<name>.db` — do not edit.
//
// Atlas config for this contrib's own database. `just db-migrate <name>` runs it
// from this directory against an ephemeral Postgres (ATLAS_DEV_URL).

variable "dev_url" {
  type    = string
  default = getenv("ATLAS_DEV_URL")
}

env "contrib_ssh" {
  src = "file://schema.sql"
  dev = var.dev_url
  migration { dir = "file://migrations" }
  format {
    migrate {
      diff = "{{ sql . \"  \" }}"
    }
  }
}
