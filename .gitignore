
.direnv/
dist/
!.envrc
# .envrc is shared dev config (direnv `use flake`) — track it even though a
# global gitignore may exclude it.
# no trailing slash: `node_modules/` matches only DIRECTORIES, and a node_modules
# SYMLINK (worktree scaffolding pointing at the main checkout) sailed straight into
# a commit past it.
node_modules
# playwright
.playwright/
playwright-report/
result
result-*
services/*/flake.lock
services/*/flake.nix
services/*/uv.lock
services/*/.venv/
test-results/
services/conversation-router/conversation-router
*.tsbuildinfo
# uv-nix generated artifacts

# mkdocs: the GENERATED option reference (one page per namespace, built by
# docs/gen_options.py from `nix build .#options-doc`) + the built site. Never committed.
docs/reference/options/
site/

# Python build artifacts (uv/setuptools leave these in the service dirs).
*.egg-info/
__pycache__/
.e2e-cluster/
